# Local Docker Desktop test config.
# Copy to .env.local or use the already created local file.

ENV_FILE=.env.local
DEBUG=False
SECRET_KEY=local-docker-test-secret-change-me

ALLOWED_HOSTS=localhost,127.0.0.1,api.pythonoku.edu.kg
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=pythonoku_local
DB_USER=pythonoku
DB_PASSWORD=pythonoku_local_password
DB_HOST=db
DB_PORT=5432

GUNICORN_WORKERS=2
NGINX_PORT=8080

GEMINI_API_KEY=

# For local tests, password reset emails are printed in backend logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PythonOku <noreply@localhost>

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
NOTIFICATIONS_USE_CELERY=True

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
