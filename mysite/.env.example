# Django
ENV_FILE=.env
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-secret

# EC2 public IP/API domain. Example:
# ALLOWED_HOSTS=13.50.10.20,api.pythonoku.edu.kg
ALLOWED_HOSTS=api.pythonoku.edu.kg

# Required when you use HTTPS or a domain through a proxy/load balancer.
# For plain HTTP EC2 IP you can leave it empty at first.
# CSRF_TRUSTED_ORIGINS=https://api.pythonoku.edu.kg,https://pythonoku.edu.kg,http://13.50.10.20
CSRF_TRUSTED_ORIGINS=https://api.pythonoku.edu.kg,https://pythonoku.edu.kg,https://www.pythonoku.edu.kg

# Frontend runs separately on Vercel, so allow the public frontend domains here.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://pythonoku.edu.kg,https://www.pythonoku.edu.kg

# PostgreSQL used by docker-compose
DB_NAME=pythonoku
DB_USER=pythonoku
DB_PASSWORD=change-this-db-password
DB_HOST=db
DB_PORT=5432

# Gunicorn
GUNICORN_WORKERS=3

# Nginx host port. Use 80 on EC2, 8080 for local Docker Desktop tests.
NGINX_PORT=80

# AI
GEMINI_API_KEY=

# Email / password reset
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=PythonOku <your-account@gmail.com>

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
NOTIFICATIONS_USE_CELERY=True

# Set True only after HTTPS is configured.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
